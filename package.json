{
  "name": "@strg-at/template-nuxt",
  "version": "0.1.0",
  "description": "Nuxt application for MethMedia",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "nuxt prepare && vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:update": "vitest -u",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@pinia/nuxt": "0.11.3",
    "@strg/logging-winston": "3.1.0",
    "nuxt": "4.5.1",
    "pinia": "3.0.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "@nuxt/test-utils": "4.0.3",
    "@pinia/testing": "1.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "prettier": "3.9.1",
    "sass": "1.101.0",
    "typescript": "5.9.3",
    "vite-svg-loader": "5.1.1",
    "vitest": "4.1.9",
    "vue-tsc": "3.3.5",
    "winston": "3.19.0"
  },
  "homepage": "https://github.com/strg-at/template-nuxt#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strg-at/template-nuxt.git"
  },
  "keywords": [],
  "author": "STRG.",
  "license": "SEE LICENSE IN LICENSE",
  "maintainers": []
}

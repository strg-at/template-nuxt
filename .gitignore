# Ignore everything
*

# Allow files and directories
!.editorconfig
!.gitignore
!.markdownlint.yaml
!.npmrc
!.nuxtrc
!.nvmrc
!.pre-commit-config.yaml
!.prettierignore
!.prettierrc.js
!.yamllint.yaml
!.github/
!.github/**
!.taskfiles/
!.taskfiles/**
!AGENTS.md
!CLAUDE.md
!CODEOWNERS
!LICENSE
!README.md
!Taskfile.yaml
!eslint.config.mjs
!nuxt.config.ts
!package.json
!package-lock.json
!tsconfig.json
!vitest.config.ts

# Application source
!app/
!app/**

# Resources directory — keep the placeholder, ignore everything else
# (e.g. the secret /resources/configuration.yaml stays untracked)
!resources/
!resources/.gitkeep

# === STRG. Agentic Coding Standards ===
# The `.standards/` clone (own .git, refreshed via `task standards:update`) and
# the installed `.agents/` + `.claude/skills/` symlinks are local tooling, not
# source. With this allowlist .gitignore they are already ignored by the leading
# `*` above — do NOT allow `.standards/`. Only allow the real custom skills and
# overrides you want tracked. See .standards/docs/installation.md.
#
# !.agents/
# !.agents/skills/
# !.agents/skills/my-custom-skill/
# !.agents/skills/my-custom-skill/**

# Ignore unnecessary files and directories inside allowed directories
# This should go after the allowed directories
**/*~
**/*.log
**/.DS_Store
**/Thumbs.db
